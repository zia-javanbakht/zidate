{
  "name": "zidate",
  "version": "0.2.0",
  "description": "Conversation-based dating: an AI interviewer builds a hidden and a shared profile, and you get two suggestions a week.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-timeout=30000 \"test/unit/*.test.js\" \"test/api/*.test.js\"",
